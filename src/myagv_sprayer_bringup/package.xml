<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>myagv_sprayer_bringup</name>
  <version>0.1.0</version>
  <description>Bringup (hardware + simulation) for the myAGV precision sprayer on the Raspberry Pi.</description>
  <maintainer email="info@maorthonet.com">Deva</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>python3-opencv</depend>
  <depend>python3-yaml</depend>

  <exec_depend>myagv_sprayer_description</exec_depend>
  <exec_depend>myagv_sprayer_navigation</exec_depend>
  <exec_depend>myagv_sprayer_gazebo</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
