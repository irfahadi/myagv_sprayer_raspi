Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 20
      Cell Size: 0.5
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan
      Topic:
        Value: /scan
      Size (m): 0.03
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: FrontCamera
      Topic:
        Value: /camera/image_raw
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic:
        Value: /map
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: SprayMarkers
      Topic:
        Value: /sprayer/markers
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: SprayCone
      Topic:
        Value: /sprayer/spray_marker
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: ArucoDebug
      Topic:
        Value: /aruco/debug_image/compressed
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Pitch: 0.6
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.1
    Name: Current View
Window Geometry:
  Height: 900
  Width: 1400
