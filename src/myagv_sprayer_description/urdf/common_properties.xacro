<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== myAGV chassis (Elephant Robotics, approx. 310 x 235 x 170 mm) ===== -->
  <xacro:property name="base_length"  value="0.310"/>
  <xacro:property name="base_width"   value="0.235"/>
  <xacro:property name="base_height"  value="0.100"/>
  <xacro:property name="base_mass"    value="3.0"/>
  <xacro:property name="ground_clearance" value="0.030"/>

  <!-- mecanum wheels -->
  <xacro:property name="wheel_radius" value="0.040"/>
  <xacro:property name="wheel_width"  value="0.035"/>
  <xacro:property name="wheel_mass"   value="0.20"/>
  <xacro:property name="wheel_x"      value="0.105"/>   <!-- half wheelbase -->
  <xacro:property name="wheel_y"      value="0.130"/>   <!-- half track -->

  <!-- sensors -->
  <xacro:property name="lidar_z"      value="0.135"/>   <!-- above base_link origin -->
  <xacro:property name="camera_x"     value="0.150"/>
  <xacro:property name="camera_z"     value="0.060"/>

  <!-- payload -->
  <!-- Raised on standoffs above the LiDAR (lidar_z=0.135, cylinder half-height 0.02,
       so its scan plane top is 0.155): the payload plate, tank and mast base all sit
       here, and without this margin they self-intersect the LiDAR's 360 deg scan ring,
       permanently reading a ~0.13 m "obstacle" and latching the emergency stop. mast_top_z,
       nozzle_z and camera_z are absolute heights and are unaffected by this offset. -->
  <xacro:property name="deck_z"       value="0.175"/>
  <xacro:property name="tank_radius"  value="0.055"/>
  <xacro:property name="tank_height"  value="0.140"/>   <!-- ~1 L -->
  <xacro:property name="nozzle_x"     value="0.190"/>
  <xacro:property name="mast_top_z"   value="0.460"/>   <!-- camera sits on top of the mast -->
  <xacro:property name="nozzle_z"     value="0.380"/>   <!-- above canopy top (~0.30 m) -->
  <xacro:property name="nozzle_pitch" value="0.25"/>    <!-- rad, tilted down: centre-line lands ~0.3 m ahead on the canopy -->

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0"
             izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0"
             izz="${m*r*r/2}"/>
  </xacro:macro>

  <material name="agv_blue"><color rgba="0.12 0.35 0.75 1"/></material>
  <material name="agv_dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="agv_grey"><color rgba="0.55 0.55 0.58 1"/></material>
  <material name="tank_cyan"><color rgba="0.20 0.75 0.85 0.6"/></material>
  <material name="pump_blue"><color rgba="0.25 0.45 0.90 1"/></material>
  <material name="nozzle_teal"><color rgba="0.10 0.70 0.65 1"/></material>
  <material name="lipo_yellow"><color rgba="0.95 0.80 0.15 1"/></material>
  <material name="jetson_green"><color rgba="0.20 0.70 0.30 1"/></material>
  <material name="relay_indigo"><color rgba="0.40 0.40 0.85 1"/></material>
  <material name="buck_orange"><color rgba="0.95 0.50 0.15 1"/></material>

</robot>
