<?xml version="1.0"?>
<!--
  myAGV Precision Sprayer - top-level robot description.

  Adapted from:
    - xaatim/beam_agrobot_v2        (modular xacro layout, gazebo_ros plugins)
    - Abhishek1010006/Mobile-Manipulator-Robot-Simulation (mobile base + camera split)

  The base approximates the Elephant Robotics myAGV (4x mecanum wheels,
  Raspberry Pi 4B, front RGB camera, 2D LiDAR).  The sprayer payload
  (LiPo, buck converter, Jetson Nano, tank, pump, nozzle) follows the
  wiring diagram "rangkaian_sistem_penyemprotan_myagv_dengan_nozzle".
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="myagv_sprayer">

  <xacro:arg name="use_sim" default="true"/>
  <xacro:arg name="prefix"  default=""/>

  <xacro:include filename="$(find myagv_sprayer_description)/urdf/common_properties.xacro"/>
  <xacro:include filename="$(find myagv_sprayer_description)/urdf/myagv_base.xacro"/>
  <xacro:include filename="$(find myagv_sprayer_description)/urdf/sprayer_payload.xacro"/>

  <xacro:myagv_base prefix="$(arg prefix)"/>
  <xacro:sprayer_payload prefix="$(arg prefix)" parent="$(arg prefix)base_link"/>

  <!-- Gazebo-only plugins (sensors, drive) -->
  <xacro:if value="$(arg use_sim)">
    <xacro:include filename="$(find myagv_sprayer_description)/urdf/sensors.gazebo.xacro"/>
    <xacro:include filename="$(find myagv_sprayer_description)/urdf/gazebo_control.xacro"/>
    <xacro:include filename="$(find myagv_sprayer_description)/urdf/gazebo_materials.xacro"/>
  </xacro:if>

</robot>
