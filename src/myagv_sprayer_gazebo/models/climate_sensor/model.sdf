<?xml version="1.0"?>
<!-- Temperature & humidity sensor enclosure (e.g. DHT22/SHT31 in a vented box).
     Model +x points into the room. -->
<sdf version="1.7">
  <model name="climate_sensor">
    <static>true</static>
    <link name="link">
      <visual name="box">
        <pose>0.03 0 0 0 0 0</pose>
        <geometry><box><size>0.06 0.09 0.13</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
      <visual name="led">
        <pose>0.061 0.025 0.045 0 0 0</pose>
        <geometry><sphere><radius>0.006</radius></sphere></geometry>
        <material><ambient>0.1 0.9 0.2 1</ambient><diffuse>0.1 1.0 0.2 1</diffuse><emissive>0.1 0.8 0.2 1</emissive></material>
      </visual>
      <collision name="collision">
        <pose>0.03 0 0 0 0 0</pose>
        <geometry><box><size>0.06 0.09 0.13</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
